{
  "guides": [
    {
      "contract": "start",
      "steps": [
        { "target": "offers", "done": "window:offers" },
        { "target": "accept", "done": "accepted:c001_direct_link" }
      ]
    },
    {
      "contract": "c001_direct_link",
      "steps": [
        { "target": "tool.wire", "done": "tool:wire" },
        { "target": "pc_a", "done": "links:>=1", "gesture": "drag", "to": "pc_b" },
        { "target": "tool.select", "done": "tool:select" },
        { "target": "pc_a", "done": "open:pc_a" },
        { "target": "tab.pc_a.config", "done": "tab:pc_a:config" },
        { "target": "ip.pc_a.0", "done": "ip:pc_a" },
        { "target": "pc_b", "done": "open:pc_b" },
        { "target": "tab.pc_b.config", "done": "tab:pc_b:config" },
        { "target": "ip.pc_b.0", "done": "ip:pc_b" },
        { "target": "test", "done": "test:pass" },
        { "target": "place", "done": "next:place" }
      ]
    },
    {
      "contract": "c002_small_office",
      "steps": [
        { "target": "shop", "done": "window:shop" },
        { "target": "buy.l2_switch_8p", "done": "owned:l2_switch_8p" },
        { "target": "inventory", "done": "placed:l2_switch" },
        { "target": "tool.wire", "done": "tool:wire" },
        { "target": "pc_a", "done": "linked:pc_a", "gesture": "drag", "to": "@l2_switch" },
        { "target": "pc_b", "done": "linked:pc_b", "gesture": "drag", "to": "@l2_switch" },
        { "target": "pc_c", "done": "linked:pc_c", "gesture": "drag", "to": "@l2_switch" },
        { "target": "test", "done": "test:pass" }
      ]
    },
    {
      "contract": "i001_office_lan",
      "steps": [
        { "target": "inventory", "done": "placed:pc" },
        { "target": "tool.wire", "done": "links:>=1" },
        { "target": "tool.select", "done": "ips:pc" },
        { "target": "test", "done": "test:pass" }
      ]
    },
    {
      "contract": "c003_departments",
      "steps": [
        { "target": "inventory", "done": "placed:router" },
        { "target": "tool.wire", "done": "tool:wire" },
        { "target": "@router", "done": "links:>=2" },
        { "target": "tool.select", "done": "tool:select" },
        { "target": "@router", "done": "open:@router" },
        { "target": "tab.@router.config", "done": "tab:@router:config" },
        { "target": "ip.@router.0", "done": "ips:router" },
        { "target": "sales_a", "done": "gateway:sales_a" },
        { "target": "test", "done": "test:pass" }
      ]
    },
    {
      "contract": "c004_web_server",
      "steps": [
        { "target": "web", "done": "open:web" },
        { "target": "tab.web.service", "done": "tab:web:service" },
        { "target": "web", "done": "service:web" },
        { "target": "test", "done": "test:pass" }
      ]
    }
  ],
  "firsts": [
    {
      "id": "hud",
      "when": "accepted:c001_direct_link",
      "steps": [
        { "target": "hud.money", "done": "next:money" },
        { "target": "hud.money", "done": "next:bankrupt" },
        { "target": "hud.date", "done": "next:date" },
        { "target": "hud.level", "done": "next:level" },
        { "target": "hud.speed", "done": "next:speed" }
      ]
    },
    {
      "id": "remove_tool",
      "when": "tool:remove",
      "steps": [
        { "target": "tool.remove", "done": "next:remove" },
        { "target": "undo", "done": "next:undo" }
      ]
    },
    {
      "id": "device_window",
      "when": "window:device",
      "steps": [
        { "target": "-", "done": "next:move" },
        { "target": "-", "done": "next:close" }
      ]
    },
    {
      "id": "rear_tab",
      "when": "tab:*:rear",
      "steps": [{ "target": "-", "done": "next:rear" }]
    },
    {
      "id": "terminal_tab",
      "when": "tab:*:terminal",
      "steps": [
        { "target": "-", "done": "next:what" },
        { "target": "-", "done": "next:help" },
        { "target": "-", "done": "next:optional" }
      ]
    },
    {
      "id": "shop",
      "when": "window:shop",
      "steps": [
        { "target": "inventory", "done": "next:inventory" },
        { "target": "-", "done": "next:sell" }
      ]
    },
    {
      "id": "staff",
      "when": "window:staffList",
      "steps": [{ "target": "-", "done": "next:staff" }]
    },
    {
      "id": "funds",
      "when": "window:funds",
      "steps": [{ "target": "-", "done": "next:funds" }]
    },
    {
      "id": "move_map",
      "when": "flag:moved",
      "steps": [
        { "target": "-", "done": "next:pc" },
        { "target": "-", "done": "next:phone" }
      ]
    },
    {
      "id": "test",
      "when": "flag:tested",
      "steps": [
        { "target": "-", "done": "next:dots" },
        { "target": "-", "done": "next:check" }
      ]
    },
    {
      "id": "test_fail",
      "when": "flag:failed",
      "steps": [
        { "target": "-", "done": "next:reason" },
        { "target": "test", "done": "next:retry" }
      ]
    },
    {
      "id": "build",
      "when": "flag:building",
      "steps": [
        { "target": "-", "done": "next:what" },
        { "target": "-", "done": "next:meanwhile" }
      ]
    },
    {
      "id": "delivered",
      "when": "flag:delivered",
      "steps": [
        { "target": "-", "done": "next:stars" },
        { "target": "hud.level", "done": "next:exp" }
      ]
    },
    {
      "id": "site",
      "when": "flag:site",
      "steps": [
        { "target": "place", "done": "next:back" }
      ]
    },
    {
      "id": "inventory",
      "when": "window:inventory",
      "steps": [
        { "target": "-", "done": "next:list" },
        { "target": "-", "done": "next:desk" }
      ]
    },
    {
      "id": "inhouse",
      "when": "flag:inhouse",
      "steps": [
        { "target": "-", "done": "next:own" }
      ]
    },
    {
      "id": "furniture",
      "when": "flag:furniture",
      "steps": [
        { "target": "-", "done": "next:range" },
        { "target": "-", "done": "next:rotate" }
      ]
    },
    {
      "id": "hiring",
      "when": "flag:hiring",
      "steps": [
        { "target": "-", "done": "next:payroll" },
        { "target": "-", "done": "next:seat" }
      ]
    },
    {
      "id": "payday",
      "when": "flag:payday",
      "steps": [
        { "target": "hud.money", "done": "next:paid" }
      ]
    },
    {
      "id": "lowfunds",
      "when": "flag:lowfunds",
      "steps": [
        { "target": "hud.money", "done": "next:low" },
        { "target": "offers", "done": "next:choose" }
      ]
    },
    {
      "id": "levelup",
      "when": "flag:levelup",
      "steps": [
        { "target": "hud.level", "done": "next:unlock" }
      ]
    },
    {
      "id": "notice",
      "when": "flag:notice",
      "steps": [
        { "target": "-", "done": "next:open" }
      ]
    },
    {
      "id": "saved",
      "when": "flag:saved",
      "steps": [
        { "target": "-", "done": "next:auto" },
        { "target": "-", "done": "next:export" }
      ]
    }
  ]
}
